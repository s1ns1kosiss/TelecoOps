generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------
// CORE & MULTI-TENANCY
// ----------------------------------------------------

enum UserRole {
  ADMIN
  DISPATCHER
  TECHNICIAN
  BILLING
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Tenant {
  id           String       @id @default(uuid())
  slug         String       @unique
  businessName String
  country      String       @default("CL")
  timezone     String       @default("America/Santiago")
  status       UserStatus   @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  users         User[]
  customers     Customer[]
  servicePlans  ServicePlan[]
  networkNodes  NetworkNode[]
  tickets       Ticket[]
  invoices      Invoice[]
  inventory     InventoryItem[]

  @@map("tenants")
}

model User {
  id          String     @id @default(uuid())
  tenantId    String
  name        String
  email       String     @unique
  phoneNumber String?
  role        UserRole   @default(TECHNICIAN)
  status      UserStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workOrders WorkOrder[] @relation("TechnicianWorkOrders")

  @@index([tenantId])
  @@map("users")
}

// ----------------------------------------------------
// BSS: SUBSCRIBERS, PLANS & SUBSCRIPTIONS
// ----------------------------------------------------

enum CustomerStatus {
  ACTIVE
  SUSPENDED
  DEBTOR
  CANCELLED
}

model Customer {
  id          String         @id @default(uuid())
  tenantId    String
  code        String
  firstName   String
  lastName    String
  taxId       String
  phone       String
  email       String?
  address     String
  geoLat      Float?
  geoLng      Float?
  status      CustomerStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscriptions CustomerSubscription[]
  tickets       Ticket[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("customers")
}

model ServicePlan {
  id                String   @id @default(uuid())
  tenantId          String
  name              String
  downloadSpeedMbps Int
  uploadSpeedMbps   Int
  monthlyPrice      Float
  technology        String   @default("FTTH")
  createdAt         DateTime @default(now())

  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscriptions CustomerSubscription[]

  @@index([tenantId])
  @@map("service_plans")
}

model CustomerSubscription {
  id               String         @id @default(uuid())
  tenantId         String
  customerId       String
  planId           String
  napBoxId         String?
  napPort          Int?
  ontSerialNumber  String?
  pppoeUser        String?
  ipAddress        String?
  status           CustomerStatus @default(ACTIVE)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  customer Customer    @relation(fields: [customerId], references: [id])
  plan     ServicePlan @relation(fields: [planId], references: [id])
  napBox   NapBox?     @relation(fields: [napBoxId], references: [id])
  invoices Invoice[]

  @@index([tenantId])
  @@map("customer_subscriptions")
}

// ----------------------------------------------------
// OSS: NETWORK INFRASTRUCTURE & FTTH MAP
// ----------------------------------------------------

model NetworkNode {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  nodeType  String   @default("POP")
  address   String
  geoLat    Float?
  geoLng    Float?
  createdAt DateTime @default(now())

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  olts   OltDevice[]

  @@index([tenantId])
  @@map("network_nodes")
}

model OltDevice {
  id           String   @id @default(uuid())
  tenantId     String
  nodeId       String
  brand        String   @default("HUAWEI")
  model        String
  managementIp String
  status       String   @default("ONLINE")
  createdAt    DateTime @default(now())

  node     NetworkNode @relation(fields: [nodeId], references: [id])
  napBoxes NapBox[]

  @@map("olt_devices")
}

model NapBox {
  id             String   @id @default(uuid())
  tenantId       String
  oltId          String
  ponPort        Int
  name           String
  geoLat         Float?
  geoLng         Float?
  totalPorts     Int      @default(16)
  availablePorts Int      @default(16)
  createdAt      DateTime @default(now())

  olt           OltDevice              @relation(fields: [oltId], references: [id])
  subscriptions CustomerSubscription[]

  @@map("nap_boxes")
}

// ----------------------------------------------------
// FIELD SERVICE & WORKFORCE (TICKETS & ORDERS)
// ----------------------------------------------------

enum TicketCategory {
  INSTALLATION
  REPAIR
  DISCONNECT
  MAINTENANCE
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CANCELLED
}

model Ticket {
  id           String         @id @default(uuid())
  tenantId     String
  ticketNumber String
  customerId   String
  category     TicketCategory @default(REPAIR)
  priority     TicketPriority @default(MEDIUM)
  status       TicketStatus   @default(OPEN)
  description  String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer   Customer    @relation(fields: [customerId], references: [id])
  workOrders WorkOrder[]

  @@unique([tenantId, ticketNumber])
  @@index([tenantId])
  @@map("tickets")
}

model WorkOrder {
  id               String       @id @default(uuid())
  tenantId         String
  ticketId         String
  technicianId     String
  startedAt        DateTime?
  completedAt      DateTime?
  status           TicketStatus @default(ASSIGNED)
  voiceNoteUrl     String?
  aiSummary        String?
  dbmSignalMeasured Float?
  photoUrls        String[]     @default([])
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  ticket     Ticket               @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  technician User                 @relation("TechnicianWorkOrders", fields: [technicianId], references: [id])
  materials  WorkOrderMaterial[]

  @@map("work_orders")
}

model InventoryItem {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  sku       String
  stock     Int      @default(0)
  unit      String   @default("PIECE")
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sku])
  @@map("inventory_items")
}

model WorkOrderMaterial {
  id           String @id @default(uuid())
  workOrderId  String
  materialName String
  quantityUsed Int    @default(1)

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@map("work_order_materials")
}

// ----------------------------------------------------
// BSS: INVOICES & PAYMENTS
// ----------------------------------------------------

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id             String        @id @default(uuid())
  tenantId       String
  subscriptionId String
  invoiceNumber  String
  amount         Float
  dueDate        DateTime
  status         InvoiceStatus @default(PENDING)
  createdAt      DateTime      @default(now())

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription CustomerSubscription @relation(fields: [subscriptionId], references: [id])
  payments     Payment[]

  @@index([tenantId])
  @@map("invoices")
}

model Payment {
  id                   String   @id @default(uuid())
  tenantId             String
  invoiceId            String
  amount               Float
  paymentMethod        String   @default("MERCADOPAGO")
  transactionReference String?
  paidAt               DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@map("payments")
}
