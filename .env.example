# Entorno y Configuración General
NODE_ENV="development"
PORT=3000

# Base de Datos (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/telecom_platform?schema=public"

# Flags de Mocks / Emulación de Red (IMPORTANTE para desarrollo aislado)
USE_HARDWARE_MOCKS="true"
WHATSAPP_MOCK_MODE="true"

# WhatsApp Business API (Próximamente en Staging/Prod)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN="teleco_verify_token_123"

# JWT / Auth Secret
NEXTAUTH_SECRET="super-secret-teleco-key-change-in-prod"
