# ====================================================
# ENTORNO DE PRODUCCIÓN (PROD) - CREDENCIALES REALES
# ====================================================
NODE_ENV="production"
PORT=3000

# Base de Datos PostgreSQL de Producción (AWS RDS / Supabase / Neon / Self-Hosted)
DATABASE_URL="postgresql://db_user:SUPER_SECURE_PASSWORD@prod-db.telecom.io:5432/telecom_prod?schema=public&sslmode=require"

# Flags de Mocks (DESACTIVADAS EN PROD PARA COMUNICARSE CON HARDWARE REAL)
USE_HARDWARE_MOCKS="false"
WHATSAPP_MOCK_MODE="false"

# WhatsApp Business Cloud API (Credenciales Reales de Meta for Developers)
WHATSAPP_TOKEN="EAAG_LIVE_PRODUCTION_TOKEN_FROM_META"
WHATSAPP_PHONE_NUMBER_ID="109849201984"
WHATSAPP_VERIFY_TOKEN="PRODUCTION_SECURE_VERIFY_TOKEN_99A821"

# Servidor ACS TR-069 (Servidor GenieACS Real)
ACS_SERVER_URL="http://acs.telecom-prod.internal:7557"
ACS_USERNAME="acs_admin"
ACS_PASSWORD="ACS_SECURE_PASSWORD_123"

# JWT / NextAuth Secret de Producción
NEXTAUTH_SECRET="PROD_SUPER_SECURE_256_BIT_RANDOM_KEY_GENERATED"
